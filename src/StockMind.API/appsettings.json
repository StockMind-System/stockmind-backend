{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "stockmind",
    "InitializeOnStartup": true
  },
  "SeedData": {
    "Enabled": false,
    "RandomSeed": 202610,
    "Version": "2026.10"
  },
  "Analytics": {
    "BaseUrl": "http://localhost:8000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Key": "development-only-change-this-key-32-chars",
    "Issuer": "StockMind",
    "Audience": "StockMind.Client",
    "ExpirationMinutes": 60
  }
}


